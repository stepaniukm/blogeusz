---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '@styles/global.css';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { locales, defaultLocale } from '@i18n/ui';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
}

const { title, image = '/og/default.png', type = 'website', publishedAt } = Astro.props;

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const description = Astro.props.description ?? t('site.description');

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image.startsWith('http') ? image : new URL(image, Astro.site).toString();

const goatCounterCode = 'stepeusz';

const pathSegments = Astro.url.pathname.split('/');
const pathRest = pathSegments.slice(2).join('/');
const alternateLinks = locales.map((lang) => ({
  lang,
  href: new URL(`/${lang}/${pathRest}`, Astro.site).toString(),
}));
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="blogeusz" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title} | blogeusz</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#1a1f2e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)" />

    {alternateLinks.map(({ lang, href }) => <link rel="alternate" hreflang={lang} href={href} />)}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(`/${defaultLocale}/${pathRest}`, Astro.site).toString()}
    />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | blogeusz`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="blogeusz" />
    <meta property="og:locale" content={locale === 'pl' ? 'pl_PL' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'pl' ? 'en_GB' : 'pl_PL'} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | blogeusz`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <ClientRouter />

    <script is:inline src="/theme.js"></script>
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "e45424b69b114d94a33c1d3e52e85076"}'></script>
    {
      goatCounterCode && (
        <script
          is:inline
          async
          src="https://gc.zgo.at/count.js"
          data-goatcounter={`https://${goatCounterCode}.goatcounter.com/count`}
        />
      )
    }
    {goatCounterCode && <script is:inline src="/goatcounter.js" />}
  </head>
  <body>
    <div class="side-pattern side-pattern-left" aria-hidden="true"></div>
    <div class="side-pattern side-pattern-right" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
