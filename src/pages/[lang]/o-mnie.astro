---
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations } from '@i18n/utils';
import { locales } from '@i18n/ui';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as 'pl' | 'en');
---

<BaseLayout title={t('about.title')} description={t('about.subtitle')}>
  <div class="wrapper">
    <h1 class="page-title">{t('about.title')}</h1>
    <p class="subtitle">{t('about.subtitle')}</p>

    <div class="prose">
      <p>
        Cześć! Mam na imię Mateusz, w chwili pisania tych słów mam 25 lat i już kilka z nich
        przepracowanych jako Full Stack Developer (Node.js). Od grudnia 2024 pracuję w startupie
        Wycieczkomat, który zajmuje się organizacją wycieczek grupowych, głównie dla młodzieży, choć
        nie tylko. Tworzę tam wewnętrzne oprogramowanie wspomagające proces wycieczkowy w całym jego
        cyklu życia.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .wrapper {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
  }

  .page-title {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .subtitle {
    margin: 0 0 2rem;
    color: var(--color-text-muted);
  }
</style>
