---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import CategoryTabs from '@components/CategoryTabs.astro';
import TagFilter from '@components/TagFilter.astro';
import PostCard from '@components/PostCard.astro';
import { collectTags, getReadingTime } from '@lib/utils';
import { useTranslations } from '@i18n/utils';
import { locales } from '@i18n/ui';

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as 'pl' | 'en');

const allPosts = await getCollection(
  'blog',
  ({ data }) => !data.draft && data.public && data.lang === lang
);

const posts = allPosts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const tags = collectTags(allPosts);

const featured = posts.filter((p) => p.data.featured).slice(0, 2);
const rest = posts.filter((p) => !p.data.featured).slice(0, 9);
---

<BaseLayout title={t('home.title')} description={t('home.description')}>
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-description">
        {t('home.description')}
      </p>
      <CategoryTabs active="dev" />
    </div>
  </section>

  <div class="content-wrapper">
    <TagFilter tags={tags} />

    {
      featured.length > 0 && (
        <div class="grid-featured">
          {featured.map((post) => (
            <PostCard
              slug={post.id}
              title={post.data.title}
              description={post.data.description}
              publishedAt={post.data.publishedAt}
              tags={post.data.tags}
              readingTime={getReadingTime(post.body || '')}
              coverImage={post.data.coverImage}
              size="large"
            />
          ))}
        </div>
      )
    }

    {
      rest.length > 0 && (
        <div class="grid-posts">
          {rest.map((post) => (
            <PostCard
              slug={post.id}
              title={post.data.title}
              description={post.data.description}
              publishedAt={post.data.publishedAt}
              tags={post.data.tags}
              readingTime={getReadingTime(post.body || '')}
              coverImage={post.data.coverImage}
            />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--color-border);
    padding: 3rem 0 2.5rem;
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-description {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-text);
    max-width: 52ch;
    line-height: 1.6;
  }

  .content-wrapper {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  .grid-featured {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .grid-posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .grid-posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid-featured {
      grid-template-columns: 1fr;
    }
    .grid-posts {
      grid-template-columns: 1fr;
    }
    .hero-description {
      font-size: 1rem;
    }
    .content-wrapper {
      padding: 0 1rem 3rem;
    }
    .hero-inner {
      padding: 0 1rem;
    }
  }
</style>
